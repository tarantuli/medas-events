{
  "name": "morphp/medas-events",
  "description": "PSR-14 event dispatcher for the Medas framework with lazy dispatch and attribute-based listener discovery",
  "keywords": [
    "events"
  ],
  "authors": [
    {
      "name": "Patrick Morpey",
      "email": "patrick@morphp.nl"
    }
  ],
  "type": "library",
  "require": {
    "morphp/medas-core": "^4",
    "php": "^8.4"
  },
  "require-dev": {
    "morphp/medas-object-instantiator": "^4",
    "morphp/medas-service-manager": "^4",
    "phpunit/phpunit": "^10"
  },
  "autoload": {
    "psr-4": {
      "Medas\\Events\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Medas\\EventsTest\\": "tests/"
    }
  }
}
